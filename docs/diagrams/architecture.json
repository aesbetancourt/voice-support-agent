  "cards": [
    {
      "dot": "violet",
      "title": "Hexagonal rule",
      "items": [
        "Dependencies point inward: adapters → application → domain",
        "The domain and application never import config",
        "tests/test_architecture.py enforces the direction"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rules in code",
      "items": [
        "Gemini proposes values only through 8 tools",
        "ScreeningSession checks must-haves, follow-ups and evidence quotes",
        "The code calculates the recommendation; a person decides"
      ]
    },
    {
      "dot": "cyan",
      "title": "Voice path",
      "items": [
        "STT_PROVIDER and TTS_PROVIDER choose the speech services",
        "Pipecat's services call their providers directly, not through the ports",
        "Tool calls still reach the same core as text and simulations"
      ]
    },
    {
      "dot": "amber",
      "title": "Job questions (RAG)",
      "items": [
        "Job information is embedded once per process",
        "Below the 0.68 match score, the question goes to the recruiter",
        "A failed search never breaks the call"
      ]
    }
  ]
}