  "cards": [
    {
      "dot": "violet",
      "title": "Hexagonal rule",
      "items": [
        "Dependencies point inward: adapters → application → domain",
        "The domain imports nothing from the project",
        "tests/test_architecture.py enforces the direction"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rules in code",
      "items": [
        "Gemini changes the ticket only through 6 tools",
        "TicketSession validates values and owns the stage",
        "Closing messages and ticket IDs are fixed text"
      ]
    },
    {
      "dot": "cyan",
      "title": "Voice path",
      "items": [
        "Pipecat runs STT → Gemini → TTS in one Python process",
        "Its Google services call Cloud directly, not through the ports",
        "Tool calls and turns still reach the same core"
      ]
    },
    {
      "dot": "amber",
      "title": "Languages and sentiment",
      "items": [
        "English or Spanish, fixed per conversation",
        "Spanish STT uses chirp_3, English latest_long",
        "Flash-Lite rates frustration in the background"
      ]
    }
  ]
