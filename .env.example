# Copy this file to .env and set the values.
# Authentication uses Application Default Credentials:
#   gcloud auth application-default login

# Required. Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=

# Vertex AI location. Gemini 3 models are served only from "global".
GOOGLE_CLOUD_LOCATION=global

# Gemini model for conversation turns, and for the end-of-call summary.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SUMMARY_MODEL=gemini-3.8-flash

# Small, fast Gemini model that rates customer frustration on each turn.
# GEMINI_SENTIMENT_MODEL=gemini-3.5-flash-lite

# Google Cloud Text-to-Speech voice (Chirp 3 HD).
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon

# Google Cloud Speech-to-Text location, and phrase hints for order numbers.
GOOGLE_STT_LOCATION=global
GOOGLE_STT_PHRASE_HINTS=true

# Failed attempts on one field before the agent escalates to a human.
MAX_FIELD_ATTEMPTS=3

# Optional paths.
# ORDERS_PATH=data/orders.json
# CONVERSATIONS_DIR=conversations

# Log level for the text CLI (DEBUG, INFO, WARNING).
# LOG_LEVEL=WARNING
