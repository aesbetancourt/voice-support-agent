# Copy this file to .env and set the values.
# Every default is in config/settings.toml. Set a variable here only to override it.
# Authentication uses Application Default Credentials:
#   gcloud auth application-default login

# --- Required -----------------------------------------------------------------------------

# Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=

# --- Speech providers ---------------------------------------------------------------------

# Speech-to-text for voice calls: google (Chirp 3) or deepgram (Nova-3).
# Both detect English or Spanish on each utterance.
STT_PROVIDER=google
# Required when STT_PROVIDER=deepgram. Create a key at https://console.deepgram.com.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Text-to-speech for voice calls: google (Chirp 3 HD) or elevenlabs (Flash v2.5).
TTS_PROVIDER=google
# Required when TTS_PROVIDER=elevenlabs. Create a key at https://elevenlabs.io/app/settings/api-keys.
# The key needs the text-to-speech permission only.
# ELEVENLABS_API_KEY=
# A voice ID. Free plans can use only the default (premade) voices through the API,
# for example EXAVITQu4vr4xnSDxMaL ("Sarah"). Voice Library voices need a paid plan.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Optional overrides -------------------------------------------------------------------

# Vertex AI location for Gemini. Gemini 3 models are served only from "global".
# GOOGLE_CLOUD_LOCATION=global

# Gemini models: the conversation, the summary, the frustration rating, the simulator judge.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash
# GEMINI_SENTIMENT_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.5-flash

# Embedding model for job questions (RAG), and its region. Embedding models are not
# served from "global".
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_LOCATION=us-central1

# Greeting language when the client does not choose one: en or es.
# The CLI option --language overrides it.
# DEFAULT_LANGUAGE=en

# Phrase hints (Google) or keyterms (Deepgram): company and screening words.
# GOOGLE_STT_PHRASE_HINTS=true

# Invalid values for one requirement before the agent passes the call to a recruiter.
# MAX_FIELD_ATTEMPTS=3

# Paths, relative to the project root.
# JOB_PATH=data/job.json
# KNOWLEDGE_PATH=data/job_knowledge.json
# CONVERSATIONS_DIR=conversations

# Log level for the text CLI (DEBUG, INFO, WARNING).
# LOG_LEVEL=WARNING
