# Copy this file to .env and set the values.
# Authentication uses Application Default Credentials:
#   gcloud auth application-default login

# Required. Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=

# Vertex AI location. Gemini 3 models are served only from "global".
GOOGLE_CLOUD_LOCATION=global

# Gemini model for conversation turns, and for the end-of-call summary.
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash

# Small, fast Gemini model that rates candidate frustration on each turn.
# GEMINI_SENTIMENT_MODEL=gemini-3.5-flash-lite

# Gemini model for the LLM judge in `screening-agent simulate`. Default: GEMINI_MODEL.
# GEMINI_JUDGE_MODEL=gemini-3.5-flash

# Embedding model for job questions (RAG), and its region. Embedding models are not
# served from "global".
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_LOCATION=us-central1

# Conversation language when the client does not choose one: en or es.
# The CLI option --language overrides it. Each language has its own STT language
# and Chirp 3 HD voice (VOICE_PROFILES in adapters/inbound/voice.py).
DEFAULT_LANGUAGE=en

# Phrase hints (company and screening words) in Speech-to-Text. The STT model and location are
# constants in adapters/inbound/voice.py (chirp_3 in "us"), shared by every language.
GOOGLE_STT_PHRASE_HINTS=true

# Invalid values for one requirement before the agent passes the call to a recruiter.
MAX_FIELD_ATTEMPTS=3

# Optional paths.
# JOB_PATH=data/job.json
# KNOWLEDGE_PATH=data/job_knowledge.json
# CONVERSATIONS_DIR=conversations

# Log level for the text CLI (DEBUG, INFO, WARNING).
# LOG_LEVEL=WARNING
